# WYGIWYH MCP Server Configuration
# Copyright (c) 2025 ReNewator.com

WYGIWYH_MCP_API_BASE_URL=https://your-wygiwyh.example.com

# Authentication mode (default: basic)
#   basic           - authenticate to the WYGIWYH API with username/password;
#                     MCP clients authenticate to this server with WYGIWYH_MCP_TOKEN
#   bearer          - authenticate to the WYGIWYH API with a static token;
#                     MCP clients authenticate to this server with WYGIWYH_MCP_TOKEN
#   incoming_bearer - OAuth 2.1 / DCR: the MCP client's Bearer token is forwarded
#                     to the WYGIWYH API for validation (requires the OAuth vars below)
WYGIWYH_MCP_API_AUTH_MODE=basic

# --- basic mode ---
WYGIWYH_MCP_API_USERNAME=your_wygiwyh_username
WYGIWYH_MCP_API_PASSWORD=your_wygiwyh_password

# --- bearer mode ---
WYGIWYH_MCP_API_BEARER_TOKEN=your_wygiwyh_api_token

# Static shared secret MCP clients present to this server in basic/bearer modes.
# If unset, a temporary token is generated at startup and printed to the log.
WYGIWYH_MCP_TOKEN=your_secure_transport_token_here

# --- incoming_bearer (OAuth 2.1 / DCR) mode only ---
WYGIWYH_MCP_AUTHORIZATION_SERVER_URL=https://your-wygiwyh.example.com
WYGIWYH_MCP_AUTHORIZATION_SERVER_METADATA_URL=
WYGIWYH_MCP_OAUTH_REQUIRED_SCOPES=mcp
# Public URL clients use to reach this MCP server (required in incoming_bearer mode).
WYGIWYH_MCP_PUBLIC_BASE_URL=
WYGIWYH_MCP_OAUTH_METADATA_TTL_SECONDS=300

# Optional: restrict to read-only tools (GET) and refuse mutations.
# Default false (full access, matching the original behaviour).
WYGIWYH_MCP_READ_ONLY=false
